# Local configuration for `make run` and friends. Copy to .env; every value
# here is a safe local default. Production reads the same variables from
# Lambda configuration and Secrets Manager (APP_SECRET_ARN).

APP_ENV=local
LISTEN_ADDR=:8080

# Database: pgx against docker-compose Postgres (`make up`). In AWS,
# DATABASE_BACKEND=dataapi with DB_CLUSTER_ARN / DB_SECRET_ARN / DB_NAME.
DATABASE_BACKEND=pg
DATABASE_URL=postgres://substratal:substratal@localhost:55432/substratal?sslmode=disable

# Public identity. ISSUER is the JWT iss; keep the production value so
# tokens look like production ones.
ISSUER=https://api.substratalapps.com
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:3000
AUTHORIZE_URL=https://auth.substratalapps.com/authorize
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Signing and encryption. Empty KMS ids = local keys: an RSA key generated
# into .dev/ on first run, and a fixed development AES key.
KMS_SIGNING_KEY_ID=
KMS_DATA_KEY_ID=
LOCAL_SIGNING_KEY_FILE=.dev/signing-key.pem
CURSOR_SECRET=local-development-cursor-secret

# Email: Mailpit catches everything; read it at http://localhost:58025.
EMAIL_BACKEND=smtp
SMTP_ADDR=localhost:51025
EMAIL_FROM=Substratal <no-reply@mail.substratalapps.com>

# Webhooks: allow http://localhost receivers locally (never in production).
WEBHOOKS_ALLOW_PRIVATE=true

# Stripe test mode (optional; billing endpoints return 503 without it).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LocalStack, for anything pointed at AWS APIs locally.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# `make seed` / `make quickstart`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local admin passphrase
